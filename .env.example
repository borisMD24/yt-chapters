# LLM de chapitrage via OpenRouter (SDK openai, baseURL OpenRouter)
# La clé peut désormais vivre dans la BASE (page /admin) : elle est prioritaire
# sur cette variable, qui ne sert plus que de repli. Laisser tel quel si la clé
# est enregistrée depuis l'administration.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=qwen/qwen3.5-27b
# Transcription (Speech-to-Text) via /audio/transcriptions d'OpenRouter
STT_MODEL=openai/whisper-large-v3-turbo
# Longueur des chunks audio (secondes) pour la transcription des médias locaux
CHUNK_SEC=300
# Espacement minimal entre chapitres locaux (secondes) : un chapitre qui commence
# moins de 180 s après le précédent est écarté. 180 s par défaut, jamais moins
# de 10 s (minimum YouTube). Sans effet sur le chapitrage YouTube.
# CHAPTER_MIN_GAP_SEC=180
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DB_PATH=data/chapters.db
PORT=3000
# Interface d'écoute. Défaut : 127.0.0.1 (boucle locale : rien n'est exposé au
# réseau local, aucune pop-up pare-feu). Mettre 0.0.0.0 pour ouvrir au réseau
# local — à ne faire que sur un réseau de confiance.
# HOST=127.0.0.1
# Dossier scanné par l'interface (fichiers audio/vidéo). Défaut : deux niveaux
# au-dessus du projet. Exemple : MEDIA_DIR=C:\Users\moi\Vidéos
# MEDIA_DIR=
# Plafond d'un envoi depuis la page (Mo). Le fichier reçu est écrit dans le
# CACHE d'envoi (voir UPLOAD_CACHE_DIR), où il est conservé le temps d'ajuster
# les bornes des chapitres.
# ATTENTION : la route d'envoi n'est pas authentifiée. Le serveur n'écoute que
# sur 127.0.0.1 par défaut ; si vous l'ouvrez au réseau (HOST=0.0.0.0), un autre
# hôte peut occuper jusqu'à UPLOAD_MAX_MB dans le cache d'envoi.
# UPLOAD_MAX_MB=2048
# Cache d'envoi : les fichiers envoyés depuis la page y sont conservés (nommés
# par l'empreinte de leur contenu), pour que la page « Ajuster les bornes »
# (/edit) puisse réécouter le média. Défaut : data/uploads (dans le projet).
# UPLOAD_CACHE_DIR=data/uploads
# Durée de conservation du cache d'envoi (jours). Défaut : 7. Au-delà, les
# fichiers sont supprimés au démarrage suivant (et à la demande via /admin,
# bouton « Vider le cache »). Les chapitres déjà enregistrés ne sont pas touchés.
# UPLOAD_RETENTION_DAYS=7
# YTDLP_BIN=/usr/local/bin/yt-dlp
