# LLM de chapitrage via OpenRouter (SDK openai, baseURL OpenRouter)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=qwen/qwen3.5-27b
# Transcription (Speech-to-Text) via /audio/transcriptions d'OpenRouter
STT_MODEL=openai/whisper-large-v3-turbo
# Longueur des chunks audio (secondes) pour la transcription des médias locaux
CHUNK_SEC=300
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DB_PATH=data/chapters.db
PORT=3000
# YTDLP_BIN=/usr/local/bin/yt-dlp
